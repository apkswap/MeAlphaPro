  "main": "electron.cjs",
  "build": {
    "appId": "com.mealpha.pro",
    "productName": "MeAlpha Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json",
      "preload.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/mealpha.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "maintainer": "apkswapp@gmail.com",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "description": "MeAlpha Pro — personal finance, goals and productivity planner",
  "homepage": "https://apkswap.github.io/MeAlphaPro/",
  "author": {
    "name": "MeAlpha",
    "email": "apkswapp@gmail.com"
  }
}
