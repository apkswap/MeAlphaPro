{
  "name": "mealpha-pro",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "desktop:dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:8080 && electron .\"",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
